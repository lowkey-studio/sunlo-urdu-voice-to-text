{
  "name": "Sunlo: Urdu voice note to text",
  "short_name": "Sunlo",
  "description": "Urdu voice notes to Urdu script, Roman Urdu and English.",
  "start_url": "/?src=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F7F6F2",
  "theme_color": "#AF3A71",
  "lang": "ur",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "audio", "accept": ["audio/*", ".opus", ".ogg", ".m4a", ".mp3", ".aac", ".wav", ".amr", "video/*"] } ] }
  }
}
